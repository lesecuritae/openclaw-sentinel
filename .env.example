SENTINEL_PORT=8080
SENTINEL_API_KEY=replace-with-a-long-random-token
DATABASE_PATH=/data/sentinel.db
RULES_PATH=/app/config/rules.yaml
POLICY_PATH=/app/config/policy.yaml
INTELLIGENCE_PATH=/app/config/intelligence.yaml
HAPROXY_COLLECTOR_ENABLED=false
HAPROXY_SOCKET=/run/haproxy/admin.sock
HAPROXY_BLOCKLIST_PATH=/etc/haproxy/sentinel-blocklist.lst
COLLECTOR_INTERVAL_SECONDS=5
HAPROXY_REQUEST_COLLECTOR_ENABLED=false
HAPROXY_REQUEST_BIND=127.0.0.1
HAPROXY_REQUEST_HOST=0.0.0.0
HAPROXY_REQUEST_PORT=1514
ACTIONS_ENABLED=false
LLM_PROVIDER=disabled
MODEL=
OPENROUTER_API_KEY=
ABUSECH_AUTH_KEY=
LOCAL_LLM_URL=http://host.docker.internal:11434
ANUBIS_URL=
# Optional comma-separated exact browser origins. Empty means same-origin only.
CORS_ORIGIN_ALLOWLIST=
